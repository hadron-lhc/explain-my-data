{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "explain-my-data",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "containers": [
    {
      "class_name": "ExplainMyData",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EXPLAIN_MY_DATA",
        "class_name": "ExplainMyData"
      }
    ]
  },
  "exports": {
    "ExplainMyData": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
